{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Cursus/Perso_Printf/my_program",  // Le programme à déboguer
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/Cursus/Perso_Printf",  // Répertoire de travail
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Prevent stepping into system functions",
                    "text": "set step-mode on",  // Empêche d'entrer dans les appels systèmes
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: gcc build active file with libft"  // Associe la tâche de compilation
        }
    ]
}
