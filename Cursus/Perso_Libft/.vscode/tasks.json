{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file with libft",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",                        // Inclut les symboles de débogage
                "${file}",                   // Compile le fichier actif
                "${workspaceFolder}/libft.a",  // Lien avec libft.a
                "-o",                        // Spécifie le nom de l'exécutable
                "${workspaceFolder}/my_program",  // L'exécutable se nomme my_program
                "-Wall", "-Wextra", "-Werror" // Active les avertissements recommandés
            ],
            "options": {
                "cwd": "${workspaceFolder}"   // Répertoire de travail
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}
