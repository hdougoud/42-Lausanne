NAME	= push_swap
GCC		= cc
CFLAGS	= -Wall -Werror -Wextra -g

LIBFT	= libft/libft.a

SOURCES	= push_swap.c check_errors.c check_duplicates.c operator_s.c \

OBJECTS	= $(SOURCES:.c=.o)

$(LIBFT):
	$(MAKE) -C libft

all: $(NAME)

$(NAME): $(LIBFT) $(OBJECTS)
	$(GCC) $(CFLAGS) $(OBJECTS) -Llibft -lft -o $(NAME)

%.o: %.c
	$(GCC) $(CFLAGS) -o $@ -c $<

clean:
	rm -f $(OBJECTS)
	$(MAKE) -C libft clean

fclean: clean
	rm -f $(NAME)
	rm -f libft/libft.a

re: fclean all
	
.PHONY: all clean fclean re